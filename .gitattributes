# Files that run on the Linux server must keep LF line endings, whatever the
# committer's Windows git settings are (a CR after a shebang or in a systemd
# unit breaks them).
*.sh text eol=lf
*.service text eol=lf
*.timer text eol=lf
*.inc text eol=lf
Dockerfile* text eol=lf
nginx.conf text eol=lf
deploy/** text eol=lf
docker-compose*.yml text eol=lf
