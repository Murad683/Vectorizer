# Copy this file to backend/.env and fill in real values.
# Never commit the real .env file.

# Google Gemini API key (required when ENVIRONMENT=prod, optional in dev)
GEMINI_API_KEY=

# Runtime environment: dev | prod
ENVIRONMENT=dev

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Maximum accepted upload size, in megabytes
MAX_UPLOAD_SIZE_MB=30

# Maximum number of pages processed per uploaded file
MAX_PAGES_PER_FILE=50

# Origin allowed by CORS (the frontend dev server)
FRONTEND_ORIGIN=http://localhost:5173
