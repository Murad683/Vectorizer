# Copy this file to backend/.env and fill in real values.
# Never commit the real .env file.

# Google Gemini API key (required when ENVIRONMENT=prod, optional in dev)
GEMINI_API_KEY=

# Gemini model used for diagram reconstruction
GEMINI_MODEL=gemini-3.1-flash-lite

# Runtime environment: dev | prod
ENVIRONMENT=dev

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Maximum accepted upload size, in megabytes
MAX_UPLOAD_SIZE_MB=30

# Maximum number of pages processed per uploaded file
MAX_PAGES_PER_FILE=50

# Origin allowed by CORS (the frontend dev server)
FRONTEND_ORIGIN=http://localhost:5173

# JWT signing secret (required in prod; use a long random string, e.g.
# `openssl rand -hex 32`)
JWT_SECRET=

# Bootstrap admin account (created on first startup if no admin exists yet;
# never recreated once any admin already exists)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Postgres connection. POSTGRES_HOST=localhost + POSTGRES_PORT=5434 is for
# running the backend directly on the host (venv/uvicorn) against the
# docker-compose postgres service's published port; 5434 (not 5432) avoids
# colliding with a locally installed Postgres that may already own 5432.
# docker-compose overrides both POSTGRES_HOST=postgres and POSTGRES_PORT=5432
# for the containerized backend, which talks to postgres over the internal
# compose network (unaffected by the host port mapping) — you don't need to
# change these two for the docker-compose path, only for host-run dev.
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
