# Template for /opt/vectorizer/.env on the server. Never commit the real file.
# Create it on the server with chmod 600; fill the empty values there.

ENVIRONMENT=prod
LOG_LEVEL=INFO

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Public origin of the site (used for CORS; cookies are same-origin via /api).
FRONTEND_ORIGIN=https://<your-domain>

MAX_UPLOAD_SIZE_MB=30
MAX_PAGES_PER_FILE=50

# Abuse / cost limits (enforced server-side; raise them here if needed)
# Jobs one user may have waiting or processing at the same time
MAX_ACTIVE_JOBS_PER_USER=3
# Jobs one user may submit per rolling 24 hours (deleting a job does not give it back)
MAX_JOBS_PER_USER_PER_DAY=30
# Hard ceiling on Gemini requests for one job, retries included
MAX_VISION_CALLS_PER_JOB=25

JWT_SECRET=
# Admin is created on first start only if no admin exists yet.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# POSTGRES_HOST/PORT are forced to the compose service by docker-compose.prod.yml.
POSTGRES_USER=vectorizer
POSTGRES_PASSWORD=
POSTGRES_DB=vectorizer
