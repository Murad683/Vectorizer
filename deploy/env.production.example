# Template for /opt/vectorizer/.env on the server. Never commit the real file.
# Create it on the server with chmod 600; fill the empty values there.

ENVIRONMENT=prod
LOG_LEVEL=INFO

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Public origin of the site (used for CORS; cookies are same-origin via /api).
FRONTEND_ORIGIN=https://<your-domain>

MAX_UPLOAD_SIZE_MB=30
MAX_PAGES_PER_FILE=50

# Abuse / cost limits (enforced server-side; raise them here if needed)
# Jobs one user may have waiting or processing at the same time
MAX_ACTIVE_JOBS_PER_USER=3
# Jobs one user may submit per rolling 24 hours (deleting a job does not give it back)
MAX_JOBS_PER_USER_PER_DAY=30
# Hard ceiling on Gemini requests for one job, retries included
MAX_VISION_CALLS_PER_JOB=25

# Page mode: an uploaded photo/scan is read as a whole page (text, flowchart,
# figures) in the same single Gemini request. Set to false to go back to
# "one image = one flowchart", then recreate the backend container.
PAGE_MODE_ENABLED=true
# Longest allowed answer for one page request (tokens). Real answers use
# 300-2000; the ceiling only stops a rare runaway answer (once 65 000 tokens).
PAGE_MAX_OUTPUT_TOKENS=12000
# Gemini list prices (USD per million tokens), used only to estimate the cost in
# the usage report (python -m app.usage_report). Update when the model changes.
GEMINI_PRICE_IN_PER_M=0.25
GEMINI_PRICE_OUT_PER_M=1.50
# PDFs: a page is a scan when one image covers this share of it (or it has under
# PDF_MIN_TEXT_CHARS characters and an image/drawing). Scans are rendered at PDF_SCAN_DPI
# and read as a whole page. The request ceiling of a PDF job is
# max(MAX_VISION_CALLS_PER_JOB, pages * VISION_CALLS_PER_PAGE + VISION_CALLS_EXTRA).
PDF_SCAN_COVERAGE=0.80
PDF_MIN_TEXT_CHARS=20
PDF_SCAN_DPI=150
VISION_CALLS_PER_PAGE=2
VISION_CALLS_EXTRA=5
# Ink-contrast check for ghost text on top of the prompt. Off on purpose: it
# dropped real lines when a box was slightly off. Needs more calibration.
GHOST_FILTER_ENABLED=false

# Uploaded INPUT files are deleted this many hours after a job is completed or
# failed (daily timer). Result files (DOCX/PPTX) are never deleted automatically.
INPUT_RETENTION_HOURS=24
# At most this many things are deleted per run
INPUT_CLEANUP_MAX_PER_RUN=100
# Reserved for later, not used yet. 0 = off.
RESULT_RETENTION_DAYS=0

JWT_SECRET=
# Admin is created on first start only if no admin exists yet.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Token of this project's own Cloudflare tunnel (Zero Trust -> Networks -> Tunnels).
# Write it on the server only; see DEPLOY.md. Never commit it.
TUNNEL_TOKEN=

# POSTGRES_HOST/PORT are forced to the compose service by docker-compose.prod.yml.
POSTGRES_USER=vectorizer
POSTGRES_PASSWORD=
POSTGRES_DB=vectorizer
