# Copy this file to frontend/.env and fill in real values.
# Never commit the real .env file.

# Backend URL the Vite dev server proxies /api/* requests to.
# Leave unset for host-run dev (npm run dev / make dev) — it defaults to
# http://localhost:8000. docker-compose sets this itself for the
# containerized frontend service (see docker-compose.yml), so you normally
# don't need to set it by hand.
VITE_API_PROXY_TARGET=http://localhost:8000
